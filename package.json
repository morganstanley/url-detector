{
  "name": "@morgan-stanley/url-detector",
  "version": "0.1.0-beta.5",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "description": "A command-line tool that scans source code and text files for URLs, detecting all discovered URLs",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "clean": "rimraf dist",
    "prepack": "node scripts/prune-bundled-grammars.js",
    "build:exe": "npm run build:exe:all",
    "build:exe:all": "npm run build:exe:linux && npm run build:exe:macos && npm run build:exe:win",
    "prebuild:exe": "node scripts/ensure-grammar-prebuilds.js",
    "build:exe:linux": "npm run prebuild:exe && bun build src/cli.ts --compile --target=bun-linux-x64 --outfile url-detector-linux",
    "build:exe:macos": "npm run prebuild:exe && bun build src/cli.ts --compile --target=bun-darwin-x64 --outfile url-detector-macos",
    "build:exe:win": "npm run prebuild:exe && bun build src/cli.ts --compile --target=bun-windows-x64 --outfile url-detector-win.exe"
  },
  "bin": {
    "url-detector": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "scanner"
  ],
  "homepage": "https://github.com/morganstanley/url-detector",
  "author": "Morgan Stanley",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/morganstanley/url-detector.git"
  },
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@tree-sitter-grammars/tree-sitter-kotlin": "1.1.0",
    "@tree-sitter-grammars/tree-sitter-toml": "0.7.0",
    "@tree-sitter-grammars/tree-sitter-xml": "0.7.0",
    "@tree-sitter-grammars/tree-sitter-yaml": "0.7.1",
    "cli-table3": "^0.6.0",
    "commander": "^15.0.0",
    "fast-glob": "^3.3.3",
    "minimatch": "^11.0.1",
    "p-limit": "^7.3.3",
    "tree-sitter": "0.25.1",
    "tree-sitter-bash": "0.25.1",
    "tree-sitter-c": "0.24.1",
    "tree-sitter-c-sharp": "0.23.5",
    "tree-sitter-cpp": "0.23.4",
    "tree-sitter-css": "0.25.0",
    "tree-sitter-go": "0.25.0",
    "tree-sitter-html": "0.23.2",
    "tree-sitter-java": "0.23.5",
    "tree-sitter-javascript": "0.25.0",
    "tree-sitter-json": "0.24.8",
    "tree-sitter-php": "0.24.2",
    "tree-sitter-python": "0.25.0",
    "tree-sitter-ruby": "0.23.1",
    "tree-sitter-scala": "0.24.0",
    "tree-sitter-typescript": "0.23.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.2",
    "@typescript-eslint/eslint-plugin": "^8.34.0",
    "@typescript-eslint/parser": "^8.34.0",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.0.2",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-license-header": "^0.9.0",
    "eslint-plugin-prettier": "^5.1.3",
    "fast-check": "^4.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "rimraf": "^6.0.1",
    "typescript": "^5.8.3",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "@tree-sitter-grammars/tree-sitter-kotlin@1.1.0": true,
    "@tree-sitter-grammars/tree-sitter-toml@0.7.0": true,
    "@tree-sitter-grammars/tree-sitter-xml@0.7.0": true,
    "@tree-sitter-grammars/tree-sitter-yaml@0.7.1": true,
    "tree-sitter@0.25.1": true,
    "tree-sitter-bash@0.25.1": true,
    "tree-sitter-c@0.23.6": true,
    "tree-sitter-c@0.24.1": true,
    "tree-sitter-c-sharp@0.23.5": true,
    "tree-sitter-cpp@0.23.4": true,
    "tree-sitter-css@0.25.0": true,
    "tree-sitter-go@0.25.0": true,
    "tree-sitter-html@0.23.2": true,
    "tree-sitter-java@0.23.5": true,
    "tree-sitter-javascript@0.23.1": true,
    "tree-sitter-javascript@0.25.0": true,
    "tree-sitter-json@0.24.8": true,
    "tree-sitter-php@0.24.2": true,
    "tree-sitter-python@0.25.0": true,
    "tree-sitter-ruby@0.23.1": true,
    "tree-sitter-scala@0.24.0": true,
    "tree-sitter-typescript@0.23.2": true,
    "unrs-resolver@1.12.2": true
  },
  "bundleDependencies": [
    "tree-sitter",
    "tree-sitter-bash",
    "tree-sitter-c",
    "tree-sitter-c-sharp",
    "tree-sitter-cpp",
    "tree-sitter-css",
    "tree-sitter-go",
    "tree-sitter-html",
    "tree-sitter-java",
    "tree-sitter-javascript",
    "tree-sitter-json",
    "tree-sitter-php",
    "tree-sitter-python",
    "tree-sitter-ruby",
    "tree-sitter-scala",
    "tree-sitter-typescript",
    "@tree-sitter-grammars/tree-sitter-kotlin",
    "@tree-sitter-grammars/tree-sitter-toml",
    "@tree-sitter-grammars/tree-sitter-xml",
    "@tree-sitter-grammars/tree-sitter-yaml"
  ]
}
